#include<stdio.h>
int main()
{
   int n,a[10],i,rev[10],j=0;
   printf("enter the size of the array:");
   scanf("%d",&n);
   printf("enter array elements:");
   for(i=0;i<=n;i++)
   {
      scanf("%d",&a[i]);
   }
   for(i=n;i>=0;i--)
   {
      rev[j]=a[i];
      j++;
   }
   printf("the reversed array:");
   for(i=0;i<=n;i++)
   {
      printf("%d",rev[i]);
   }
}
