#include<stdio.h>
int main()
{
   int n,i,j,rev=0;
   printf("enter the value of n:");
   scanf("%d",&n);
   i=n;
   while(i!=0)
   {
      j=i%10;
      rev+=j*j*j;
      i=i/10;
   }
   if(rev==n)
   {
      printf("the given number is armstrong number");
   }
   else
   {
      printf("the given number is not armstrong number");
   }
}
