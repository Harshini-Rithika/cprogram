#include <stdio.h>
#include <string.h>
#include <stdbool.h>
char* removeDuplicateLetters(char* s) {
    int len = strlen(s);
    int last_idx[26] = {0};
    for (int i = 0; i < len; i++) {
        last_idx[s[i] - 'a'] = i;
    }
    bool visited[26] = {false};
    static char stack[27]; 
    int top = -1;
    for (int i = 0; i < len; i++) {
        int curr = s[i] - 'a';
        if (visited[curr]) {
            continue;
        }
        while (top >= 0 && stack[top] > s[i] && last_idx[stack[top] - 'a'] > i) {
            visited[stack[top] - 'a'] = false;
            top--;
        }
        stack[++top] = s[i];
        visited[curr] = true;
    }
    stack[top + 1] = '\0';
    return stack;
}
