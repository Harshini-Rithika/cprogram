#include<stdio.h>
int power(int x,int n);

int main()
{
   int x,n,xpowern;
   printf("enter x and n:");
   scanf("%d %d",&x,&n);
   xpowern=power(x,n);
   printf("x to the power of n=%ld",xpowern);
}
int power(int x,int n)
{
   if(n==0)
      return 1;
   else if(n==1)
      return(x);
   else if (n>1)
       return (x*power(x,n-1));
}
