#include<stdio.h>
int main()
{
   int n,re,rev=0,m;
   printf("enter the value of n:");
   scanf("%d",&n);
   m=n;
   while(n>0)
   {
      re=n%10;
      rev=rev*10+re;
      n=n/10;
   }
   if(m==rev)
   {
      printf("the given number is palindrome");
   }
   else
   {
      printf("the given number is not palindrome");
   }
}
