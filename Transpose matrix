#include<stdio.h>
int main()
{
   int a[10][10],c,r,i,j,temp;
   printf("enter the size of row r:");
   scanf("%d",&r);
   printf("enter the size of column c:");
   scanf("%d",&c);
   printf("enter the elements:\n");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         scanf("%d",&a[i][j]);
      }
   }
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         temp=a[i][j];
         a[i][j]=a[j][i];
         a[j][i]=temp;
      }
      }
   printf("the transpose of the matrix is:\n");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         printf("%d",a[j][i]);
      }
      printf("\n");
   }
}
